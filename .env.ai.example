# Server only. Never prefix model keys with VITE_ or commit .env.ai.
# This is the separate VIDEO backend. Codex is the harness; Gemini is the model.
# No CODEX_API_KEY, OPENAI_API_KEY or desktop login is needed.
MOUVA_CODEX_MAX_CONCURRENT=4
MOUVA_CODEX_MAX_QUEUED=16
MOUVA_CODEX_TIMEOUT_MS=120000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional native Gemini API endpoint (HTTPS only).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ARK_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-5-260628

# Required on a server: use a random value with at least 32 characters.
MOUVA_ACCESS_TOKEN=
# local: private single-user workspace; mouva: account-isolated hosted service.
MOUVA_AUTH_MODE=local
# Required only for mouva mode. Generate independently; never use the main JWT secret.
MOUVA_SESSION_SECRET=
MOUVA_FRONTEND_ORIGIN=
MOUVA_LOGIN_ORIGIN=
MOUVA_IDENTITY_URL=
# Public HTTPS origin serving this app, e.g. https://studio.example.com
# Reference video URLs must be reachable from the internet by Seedance.
MOUVA_PUBLIC_ORIGIN=
# Optional instead of MOUVA_PUBLIC_ORIGIN when a reverse proxy uses a path prefix:
# MOUVA_PUBLIC_BASE_URL=https://api.example.com/video-api

# Optional alternative publisher: POST multipart file + jobId; return {"url":"https://..."}.
# Use a provider-accessible URL valid for at least 24 hours.
MOUVA_MEDIA_UPLOAD_URL=
MOUVA_MEDIA_UPLOAD_TOKEN=

# Local development defaults. Docker overrides these paths and bindings.
MOUVA_AI_HOST=127.0.0.1
MOUVA_AI_PORT=5175
MOUVA_AI_DATA_DIR=.mouva-ai
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
# FFMPEG_PATH=ffmpeg
